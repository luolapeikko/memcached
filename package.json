{
  "name": "@luolapeikko/memcached",
  "version": "0.0.3",
  "description": "Javascript memcached server",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "bin": {
    "memcached": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "lint": "biome check",
    "test": "vitest run --coverage",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "memcached",
    "npm",
    "server",
    "memcache",
    "cache",
    "caching",
    "in-memory",
    "database"
  ],
  "author": "mharj",
  "repository": {
    "type": "git",
    "url": "https://github.com/luolapeikko/memcached"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/memcached": "^2.2.10",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "memcached": "^2.2.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@luolapeikko/level-logger": ">= 0.1.0",
    "@luolapeikko/logger-type": ">= 0.1.0",
    "@luolapeikko/result-option": ">= 1.0.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
