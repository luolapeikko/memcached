{
  "name": "@luolapeikko/memcached",
  "version": "0.0.5",
  "description": "Javascript memcached server",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "bin": {
    "memcached": "./cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "test": "vitest run --coverage",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist",
    "cli.mjs"
  ],
  "keywords": [
    "memcached",
    "npm",
    "server",
    "memcache",
    "cache",
    "caching",
    "in-memory",
    "database"
  ],
  "author": "mharj",
  "repository": {
    "type": "git",
    "url": "https://github.com/luolapeikko/memcached"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/memcached": "^2.2.10",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "memcached": "^2.2.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@luolapeikko/level-logger": ">= 0.1.0",
    "@luolapeikko/logger-type": ">= 0.1.0",
    "@luolapeikko/result-option": ">= 1.0.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
